{
    "name": "ollave",
    "version": "0.1.3",
    "repository": "git@github.com:rdroe/ollave.git",
    "license": "MIT",
    "description": "framework for developing musical streams",
    "keywords": [
        "yargs",
        "node",
        "browser",
        "cli"
    ],
    "dependencies": {
        "@tonejs/piano": "^0.2.1",
        "@types/jsmidgen": "^0.1.0",
        "http-server": "^14.1.0",
        "jsmidgen": "^0.1.5",
        "peprn": "^0.4.12",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rxjs": "^7.5.7",
        "tonal": "^5.0.0",
        "tone": "14.6.1",
        "user-tables": "^0.0.19",
        "webmidi": "2.*"
    },
    "devDependencies": {
        "@types/isomorphic-fetch": "^0.0.36",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "concurrently": "^8.2.2",
        "esbuild": "^0.14.38",
        "nodemon": "^2.0.16",
        "typescript": "^5.0.0"
    },
    "main": "ollave",
    "exports": {
        "./commands": "./public/js/commands/index.js",
        "./lib": "./public/js/lib/index.js",
        "./cli": "./public/js/cli.js"
    },
    "typesVersions": {
        "*": {
            "*": [
                "public/js"
            ],
            "lib": [
                "public/js/lib/index.d.ts"
            ],
            "commands": [
                "public/js/commands/index.d.ts"
            ],
            "cli": [
                "public/js/cli.d.ts"
            ]
        }
    },
    "scripts": {
        "note": "echo \"first build typescript; then build javascript, which will work off of typescript output; at any time, build css. to understand the goal of the build, see main.js. main.js imports the results of the build.",
        "ts-dev": "tsc -w",
        "ts-build": "tsc",
        "js-build": "node build.js",
        "css-build": "esbuild --bundle css/main.css --outfile=public/css/style.css",
        "mon-sub": "yarn nodemon --exec \"yarn ts-build && yarn css-build && yarn js-build\" --watch ../../dist-browser --watch ./src --watch ./css --ext js,ts,mjs,ts,css  --ignore public",
        "start": "yarn http-server --mimetypes mime.types --cors",
        "mon": "yarn concurrently \"yarn http-server -p 8080\" \"yarn mon-sub\""
    },
    "packageManager": "yarn@4.0.2"
}
